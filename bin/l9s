#!/usr/bin/env bash
# l9s — run local LLMs behind one OpenAI-compatible endpoint, with a k9s-style TUI.
#
# Deployments (BACKEND in ~/.l9s/env):
#   vllm  Linux + NVIDIA (or AMD ROCm) GPU, vLLM in Docker. Tuned automatically for unified-memory boxes
#         such as the NVIDIA GB10 / DGX Spark; works on discrete and multi-GPU machines too.
#   mlx   Apple Silicon Macs: mlx-lm's OpenAI-compatible server, run as a launchd agent.
#
# Config:   ~/.l9s/env, written by l9s itself (TUI Settings, l9s config / mode / expose): not meant for hand edits
# Profiles: ~/.l9s/profiles/<name>  (line 1: HF repo id, `ENV K=V` lines, then one server flag per line)
set -euo pipefail

L9S_HOME="${L9S_HOME:-$HOME/.l9s}"
PROFILES="$L9S_HOME/profiles"
APP="$L9S_HOME/app"
PY="$APP/.venv/bin/python"
HF_CACHE="${HF_HOME:-$HOME/.cache/huggingface}"
mkdir -p "$PROFILES" "$L9S_HOME/logs"
[[ -f "$L9S_HOME/env" ]] && source "$L9S_HOME/env"
BACKEND="${BACKEND:-vllm}"
PORT="${PORT:-8000}"                                 # public endpoint (l9s-proxy)
BACKEND_PORT="${BACKEND_PORT:-${VLLM_PORT:-8001}}"   # model server, localhost only
GPU_MEM="${GPU_MEM:-0.85}"
IMAGE="${IMAGE:-vllm/vllm-openai:v0.33.0}"
CONTAINER="${CONTAINER:-l9s-vllm}"
GPU_ARGS="${GPU_ARGS:---gpus all}"
HF="$HOME/.local/bin/hf"
OS="$(uname -s)"
LABEL="dev.l9s.backend"
PROXY_LABEL="dev.l9s.proxy"
LOG="$L9S_HOME/logs/backend.log"

die() { echo "error: $*" >&2; exit 1; }
need_key() { [[ -n "${API_KEY:-}" ]] || die "no API key yet: set one in the TUI (Settings) or with: l9s config set API_KEY <key>"; }
active_profile() { [[ -L "$L9S_HOME/active" ]] && basename "$(readlink "$L9S_HOME/active")" || true; }

usage() {
  cat <<EOF
usage: l9s [command] [args]          (no command: open the terminal UI)

  quickstart [org/repo]                  pull and serve a model with recommended settings
                                         (no repo: the largest starter model that fits this machine)
  pull <org/repo> [hf args]              download a model (skips files the server never reads)
  info <org/repo>                        model analysis: fit, context, parsers, recommended settings
  serve <org/repo> [--name N] [--env K=V]... [server flags...]
                                         save a profile and (re)start the server with it
  use <profile>                          switch to a saved profile
  profiles                               list saved profiles (* = active)
  optimize [<profile>|--all] [-y]        give saved profiles the fastest settings l9s knows (drafters, MTP, …)
  keys [add <name>|revoke <name>|usage]  API keys for other people, with limits and usage (l9s keys --help)
  mode [personal|shared|client]          what this device is for: serve you, serve many people, or use others' servers
  link [add <name> <url> --key K|rm]     use someone else's l9s server: its models join yours as <name>/<model>
  expose [local|lan|vpn|cloudflare|tailscale|caddy <host>|url <URL>]
                                         how other devices reach this server: this machine only, your network, a VPN,
                                         or the internet over HTTPS (l9s expose --help)
  config [get|set NAME value]            every other setting (same as the TUI's Settings tab)
  ls | rm <org/repo>                     downloaded models / delete one
  status | logs [-f] | test              health, server log, test request
  stop | start | restart                 control the model server
  proxy status|restart|logs              the request proxy in front of the server
  upgrade <image:tag>                    (vllm) switch vLLM image
  hw                                     detected hardware and deployment
  key                                    print the API key
  connect [tool] [--remove|--print]      set up Claude Code, Codex, OpenCode, Cursor, … to use this server
                                         (no tool: list them; --server <ssh-host>: target another l9s)
  run <tool> [-m model] [args]           launch a CLI agent against l9s without changing its normal setup
                                         (shortcuts: l9s claude, l9s codex, l9s opencode, …)
  tui                                    open the terminal UI
  update [--check] [-y]                  check for / install a newer l9s (and mlx-lm on a Mac)
  alerts [test]                          where alerts go (set: l9s config set ALERT_URL …) / send a test one
  doctor [--fix [-y]]                    is everything working? what's wrong, why, and fixes
  report [--anonymize] [--issue]         a file with what's needed to debug a problem (secrets removed), to attach
                                         to a GitHub issue; nothing is sent
  backup [now|list] | restore [<id>]     backups of your setup (taken before updates, mode / access changes,
                                         uninstall) and bringing one back
  uninstall [-y] [--purge] [--remove-models] [--remove-image]
                                         remove l9s; your setup stays for a reinstall unless --purge

deployment: $BACKEND   endpoint: $(endpoint)/v1
EOF
}

host_ip() {
  if [[ -x "$PY" ]]; then "$PY" -c "import sys; sys.path.insert(0, '$APP'); import hw; print(hw.host_ip())" 2>/dev/null && return; fi
  hostname -I 2>/dev/null | awk '{print $1}' || echo localhost
}

# ------------------------------------------------------------------ backend: vllm (docker)
vllm_start_profile() {
  local name="$1" repo="$2"; shift 2
  local -a envs=() flags=() gpu_args=()
  read -ra gpu_args <<< "$GPU_ARGS"
  while [[ $# -gt 0 ]]; do
    if [[ "$1" == "ENV "* ]]; then envs+=(-e "${1#ENV }"); else flags+=("$1"); fi; shift
  done
  docker rm -f "$CONTAINER" >/dev/null 2>&1 || true
  docker run -d --name "$CONTAINER" \
    ${gpu_args[@]+"${gpu_args[@]}"} --ipc=host --restart unless-stopped \
    -p "127.0.0.1:$BACKEND_PORT:8000" \
    -v "$HF_CACHE:/root/.cache/huggingface" \
    -e HF_TOKEN="${HF_TOKEN:-}" \
    -e VLLM_API_KEY="$API_KEY" \
    ${envs[@]+"${envs[@]}"} \
    --label l9s.profile="$name" --label llm.profile="$name" \
    "$IMAGE" \
    "$repo" --served-model-name "$name" --host 0.0.0.0 --port 8000 \
    --gpu-memory-utilization "$GPU_MEM" ${flags[@]+"${flags[@]}"} >/dev/null
}
vllm_running() { [[ "$(docker inspect -f '{{.State.Running}}' "$CONTAINER" 2>/dev/null)" == "true" ]]; }

# ------------------------------------------------------------------ backend: mlx (launchd)
plist_path() { echo "$HOME/Library/LaunchAgents/$1.plist"; }
xml() { sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' <<< "$1"; }
mlx_start_profile() {
  local name="$1" repo="$2"; shift 2
  local args="" envxml="<key>HF_TOKEN</key><string>$(xml "${HF_TOKEN:-}")</string>"
  # -W: mlx-lm warns its server only has basic security checks. Here it listens on 127.0.0.1 only and l9s-proxy
  # enforces the API key in front of it, so the warning is noise in the server log.
  for a in "$PY" -W "ignore:mlx_lm.server is not recommended" -m mlx_lm server \
           --model "$repo" --host 127.0.0.1 --port "$BACKEND_PORT"; do
    args+="<string>$(xml "$a")</string>"; done
  while [[ $# -gt 0 ]]; do
    if [[ "$1" == "ENV "* ]]; then local kv="${1#ENV }"; envxml+="<key>$(xml "${kv%%=*}")</key><string>$(xml "${kv#*=}")</string>"
    else args+="<string>$(xml "$1")</string>"; fi; shift
  done
  [[ -f "$LOG" ]] && mv "$LOG" "$LOG.1"
  mkdir -p "$HOME/Library/LaunchAgents"
  cat > "$(plist_path $LABEL)" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key><array>$args</array>
  <key>EnvironmentVariables</key><dict>$envxml<key>L9S_PROFILE</key><string>$(xml "$name")</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>StandardOutPath</key><string>$LOG</string>
  <key>StandardErrorPath</key><string>$LOG</string>
</dict></plist>
EOF
  launchd_load "$LABEL"
}
# (re)load a launchd agent. bootout returns before the old job is gone, and bootstrapping too early fails with
# "Input/output error", so wait for it to disappear and retry.
launchd_load() {
  local label="$1" i
  launchctl bootout "gui/$UID/$label" 2>/dev/null || true
  for i in $(seq 1 50); do launchctl print "gui/$UID/$label" >/dev/null 2>&1 || break; sleep 0.2; done
  launchctl enable "gui/$UID/$label"
  for i in 1 2 3 4 5; do
    launchctl bootstrap "gui/$UID" "$(plist_path "$label")" 2>/dev/null && return 0
    sleep 1
  done
  die "launchctl couldn't start $label"
}
mlx_running() { launchctl print "gui/$UID/$LABEL" 2>/dev/null | grep -q "state = running"; }

# ------------------------------------------------------------------ common
# clients that recently asked for another model by name will switch the server back on their next request
pin_warning() {
  [[ "${MODEL_SWITCH:-auto}" == off ]] && return 0
  "$PY" - "$1" "$PORT" 2>/dev/null <<'PY' || true
import json, sys, urllib.parse, urllib.request
url = f"http://127.0.0.1:{sys.argv[2]}/_l9s/pins?away_from={urllib.parse.quote(sys.argv[1])}"
pins = json.load(urllib.request.urlopen(url, timeout=1)).get("pins", [])
for p in pins[:3]:
    ago = f"{p['ago']}s" if p["ago"] < 90 else f"{p['ago'] // 60} min"
    ua = (p.get("ua") or "?").split(" ")[0]
    print(f"note: {p.get('client')} ({ua}) asked for {p['model']} {ago} ago: its next request switches the server back.")
if pins:
    print("      (sessions started with `l9s claude` / `l9s run` follow whatever is loaded and don't do this)")
PY
}

# the URL people elsewhere use: PUBLIC_URL (e.g. https://llm.example.com behind Caddy / a tunnel) or the LAN address
endpoint() { if [[ -n "${PUBLIC_URL:-}" ]]; then echo "${PUBLIC_URL%/}"; else echo "http://$(host_ip):$PORT"; fi; }

run_profile() {
  local name="$1" file="$PROFILES/$1"
  [[ -f "$file" ]] || die "no profile '$name' (see: l9s profiles)"
  need_key
  local repo; repo="$(head -1 "$file")"
  local -a lines=()
  while IFS= read -r l; do [[ -n "$l" ]] && lines+=("$l"); done < <(tail -n +2 "$file")
  echo "==> starting $name ($repo) [$BACKEND]"
  if [[ "$BACKEND" == "mlx" ]]; then mlx_start_profile "$name" "$repo" ${lines[@]+"${lines[@]}"}
  else vllm_start_profile "$name" "$repo" ${lines[@]+"${lines[@]}"}; fi
  ln -sfn "$file" "$L9S_HOME/active"
  rm -f "$L9S_HOME/cache/restart-pending"
  "$PY" "$APP/connect.py" refresh -q >/dev/null 2>&1 || true   # tools whose config lists the models
  wait_ready
}

backend_running() { if [[ "$BACKEND" == "mlx" ]]; then mlx_running; else vllm_running; fi; }

wait_ready() {
  echo -n "==> waiting for the model server (first load of a model can take a few minutes)"
  for _ in $(seq 1 720); do
    if curl -sf -H "Authorization: Bearer $API_KEY" "localhost:$BACKEND_PORT/v1/models" >/dev/null 2>&1; then
      echo; echo "==> ready: $(active_profile) on $(endpoint)/v1"; return 0
    fi
    if ! backend_running; then
      echo; backend_logs --tail 40; die "model server exited"
    fi
    echo -n .; sleep 5
  done
  echo; die "timed out; check: l9s logs"
}

backend_logs() {
  if [[ "$BACKEND" == "mlx" ]]; then
    if [[ "${1:-}" == "-f" ]]; then tail -n 100 -F "$LOG"; else tail -n "${2:-100}" "$LOG" 2>/dev/null; fi
  else
    if [[ "${1:-}" == "-f" ]]; then docker logs -f --tail 100 "$CONTAINER"; else docker logs --tail "${2:-100}" "$CONTAINER" 2>&1; fi
  fi
}

proxy_ctl() {
  local action="${1:-status}"
  if [[ "$OS" == "Darwin" ]]; then
    case "$action" in
      status) launchctl print "gui/$UID/$PROXY_LABEL" 2>/dev/null | grep -E "state =|pid =" || echo "l9s-proxy: not running" ;;
      start) launchd_load "$PROXY_LABEL" ;;
      stop) launchctl bootout "gui/$UID/$PROXY_LABEL" ;;
      restart) launchctl kickstart -k "gui/$UID/$PROXY_LABEL" ;;
      logs) tail -n 100 "$L9S_HOME/logs/proxy.log" ;;
      *) die "usage: l9s proxy status|start|stop|restart|logs" ;;
    esac
  else
    case "$action" in
      status) systemctl status l9s-proxy --no-pager | head -5 ;;
      start|stop|restart) sudo systemctl "$action" l9s-proxy ;;
      logs) journalctl -u l9s-proxy -n 100 --no-pager ;;
      *) die "usage: l9s proxy status|start|stop|restart|logs" ;;
    esac
  fi
}

cmd="${1:-tui}"; shift || true

# one-line notice when the cached daily check found an update (no network here)
UPCACHE="$L9S_HOME/cache/update.json"
case "$cmd" in
  tui|ui|update|key|help|-h|--help|uninstall) ;;
  *) if [[ -t 2 && -f "$UPCACHE" ]] && grep -q '"update": true' "$UPCACHE" 2>/dev/null; then
       echo "l9s: an update is available (run: l9s update)" >&2
     fi ;;
esac
# client mode: there is no local model server to start, stop or serve with
if [[ "${BACKEND:-}" == "remote" ]]; then
  case "$cmd" in
    quickstart|serve|use|start|restart|stop|upgrade|test|logs|optimize)
      die "client mode: this device has no model server of its own (it uses linked servers: l9s link).
       To serve models here: l9s mode personal" ;;
  esac
fi
case "$cmd" in
  pull)
    [[ $# -ge 1 ]] || die "usage: l9s pull <org/repo>"
    extra=()
    if [[ " $* " != *" --include "* && " $* " != *" --exclude "* ]]; then
      pats=()
      while IFS= read -r pat; do [[ -n "$pat" ]] && pats+=("$pat") && extra+=(--exclude "$pat"); done \
        < <("$PY" "$APP/hfmeta.py" exclude "$1" 2>/dev/null)
      [[ ${#pats[@]} -gt 0 ]] && echo "==> skipping files the server doesn't use: ${pats[*]}  (pass --include/--exclude to override)"
    fi
    # network hiccups are common on big downloads: try again (it resumes where it stopped) before giving up
    for try in 1 2 3 4; do
      if HF_TOKEN="${HF_TOKEN:-}" "$HF" download "$@" ${extra[@]+"${extra[@]}"} 2> >(tee "$L9S_HOME/logs/pull.err" >&2); then
        exit 0
      fi
      if grep -qiE "401|403|gated|not found|404|Repository Not Found" "$L9S_HOME/logs/pull.err" 2>/dev/null; then
        grep -qiE "gated|401|403" "$L9S_HOME/logs/pull.err" \
          && die "$1 needs access: accept its license on huggingface.co/$1 and add your token in Settings (or: l9s config set HF_TOKEN hf_…)" \
          || die "$1 isn't on Hugging Face (check the name)"
      fi
      [[ $try -lt 4 ]] && { echo "==> the download was interrupted (network): trying again in $((try * 10))s, it picks up where it stopped (try $((try + 1)) of 4)" >&2; sleep $((try * 10)); }
    done
    die "couldn't download $1 after 4 tries: check the network, then run the same command again (it resumes)" ;;
  info) [[ $# -eq 1 ]] || die "usage: l9s info <org/repo>"; "$PY" "$APP/hfmeta.py" report "$1" ;;
  optimize) "$PY" "$APP/hfmeta.py" optimize "$@" ;;
  keys) exec "$PY" "$APP/keys.py" "$@" ;;
  expose) exec "$PY" "$APP/expose.py" "$@" ;;
  mode) exec "$PY" "$APP/mode.py" "$@" ;;
  link|links) exec "$PY" "$APP/links.py" "$@" ;;
  config) exec "$PY" "$APP/config.py" "$@" ;;
  backup|backups) exec "$PY" "$APP/backup.py" "$@" ;;
  restore) exec "$PY" "$APP/backup.py" restore "$@" ;;
  report) exec "$PY" "$APP/report.py" "$@" ;;
  doctor) exec "$PY" "$APP/doctor.py" "$@" ;;
  alerts) exec "$PY" "$APP/alerts.py" "$@" ;;
  quickstart)
    repo="${1:-}"
    if [[ -z "$repo" ]]; then
      echo "==> picking a starter model that fits this machine"
      repo="$("$PY" "$APP/hfmeta.py" starter)" || die "no starter model fits; pick one with: l9s info <org/repo>"
    fi
    echo "==> model: $repo"
    args="$("$PY" "$APP/hfmeta.py" serveargs "$repo")" || die "$repo can't be served here (see: l9s info $repo)"
    "$0" pull "$repo"
    eval "set -- $args"
    echo "==> serving with the recommended settings: $*"
    exec "$0" serve "$@" ;;
  serve)
    [[ $# -ge 1 ]] || die "usage: l9s serve <org/repo> [--name N] [--env K=V]... [flags...]"
    repo="$1"; shift
    name="$(basename "$repo" | tr 'A-Z' 'a-z')"; envs=()
    while [[ "${1:-}" == "--name" || "${1:-}" == "--env" ]]; do
      if [[ "$1" == "--name" ]]; then name="$2"; else envs+=("$2"); fi; shift 2
    done
    { echo "$repo"; for e in ${envs[@]+"${envs[@]}"}; do echo "ENV $e"; done; for a in "$@"; do echo "$a"; done; } > "$PROFILES/$name"
    echo "==> saved profile '$name'"
    run_profile "$name" ;;
  use) [[ $# -eq 1 ]] || die "usage: l9s use <profile>"; [[ -t 1 ]] && pin_warning "$1"; run_profile "$1" ;;
  profiles)
    act="$(active_profile)"
    for f in "$PROFILES"/*; do [[ -f "$f" ]] || continue
      n="$(basename "$f")"; m=" "; [[ "$n" == "$act" ]] && m="*"
      printf "%s %-28s %s  %s\n" "$m" "$n" "$(head -1 "$f")" "$(tail -n +2 "$f" | tr '\n' ' ')"
    done ;;
  ls) "$HF" cache ls 2>/dev/null || "$HF" cache scan ;;
  rm) [[ $# -eq 1 ]] || die "usage: l9s rm <org/repo>"; "$HF" cache rm "model/$1" -y ;;
  status)
    echo "mode: $("$PY" -c "import sys; sys.path.insert(0, '$APP'); import mode; print(mode.current())" 2>/dev/null)   endpoint: $(endpoint)/v1"
    if [[ "${BACKEND:-}" == "remote" ]]; then "$PY" "$APP/links.py" list; exit 0; fi
    echo "deployment: $BACKEND   profile: $(active_profile)"
    backend_running && echo "server: running" || echo "server: stopped"
    proxy_ctl status | head -2
    need_key; curl -s -m 3 -H "Authorization: Bearer $API_KEY" "localhost:$BACKEND_PORT/v1/models" \
      | python3 -c 'import sys,json;[print("serving:",m["id"]) for m in json.load(sys.stdin)["data"]]' 2>/dev/null \
      || echo "serving: (not ready)" ;;
  logs) backend_logs "${1:-}" ;;
  stop)
    if [[ "$BACKEND" == "mlx" ]]; then launchctl bootout "gui/$UID/$LABEL" 2>/dev/null || true; launchctl disable "gui/$UID/$LABEL"
    else docker stop "$CONTAINER" >/dev/null; fi; echo "stopped" ;;
  start)
    need_key
    if [[ "$BACKEND" == "mlx" ]]; then
      launchctl print "gui/$UID/$LABEL" >/dev/null 2>&1 || launchd_load "$LABEL"
    else docker start "$CONTAINER" >/dev/null; fi
    wait_ready ;;
  restart)
    need_key
    rm -f "$L9S_HOME/cache/restart-pending"
    if [[ "$BACKEND" == "mlx" ]]; then launchctl kickstart -k "gui/$UID/$LABEL"; else docker restart "$CONTAINER" >/dev/null; fi
    wait_ready ;;
  test)
    need_key; m="$(active_profile)"
    curl -s -H "Authorization: Bearer $API_KEY" -H 'Content-Type: application/json' "localhost:$PORT/v1/chat/completions" \
      -d "{\"model\":\"$m\",\"messages\":[{\"role\":\"user\",\"content\":\"Say hello in five words.\"}],\"max_tokens\":512}" \
      | python3 -c 'import sys,json;r=json.load(sys.stdin);print(r["choices"][0]["message"]["content"]);print(r["usage"])' ;;
  key) need_key; echo "$API_KEY" ;;
  connect) exec "$PY" "$APP/connect.py" "$@" ;;
  run) exec "$PY" "$APP/connect.py" run "$@" ;;
  claude|codex|opencode|crush|aider|goose|qwen|grok|droid) exec "$PY" "$APP/connect.py" run "$cmd" "$@" ;;
  hw) "$PY" "$APP/hw.py" ;;
  upgrade)
    [[ "$BACKEND" == "vllm" ]] || die "upgrade is for the vllm deployment (mlx: l9s update brings tested mlx-lm versions)"
    [[ $# -eq 1 ]] || die "usage: l9s upgrade <image:tag>"
    docker pull "$1"
    sed -i '/^IMAGE=/d' "$L9S_HOME/env"; echo "IMAGE=$1" >> "$L9S_HOME/env"; IMAGE="$1"
    a="$(active_profile)"; [[ -n "$a" ]] && run_profile "$a" ;;
  proxy) proxy_ctl "${1:-status}" ;;
  tui|ui)
    # exit code 75 = the TUI updated l9s and asks to be relaunched on the new version
    while :; do
      rc=0; "$PY" "$APP/tui.py" "$@" || rc=$?
      [[ $rc -eq 75 ]] || exit $rc
    done ;;
  update)
    check=0 yes=0 scheduled=0
    for a in "$@"; do
      case "$a" in
        --check) check=1 ;; -y|--yes) yes=1 ;; --scheduled) scheduled=1 ;;
        -h|--help) echo "usage: l9s update [--check] [-y]   (automatic updates: ${UPDATE_MODE:-notify}; change in Settings › Updates or: l9s config set UPDATE_MODE notify|auto|off)"; exit 0 ;;
        *) die "usage: l9s update [--check] [-y]" ;;
      esac
    done
    if [[ $scheduled -eq 1 ]]; then
      echo "== $(date '+%F %T') scheduled check (UPDATE_MODE=${UPDATE_MODE:-notify})"
      case "${UPDATE_MODE:-notify}" in
        off) exit 0 ;;
        notify) "$PY" "$APP/updater.py" check --force; exit 0 ;;
        auto) yes=1 ;;
      esac
    fi
    # automatic updates only ever install stable releases (a beta channel still gets told about betas)
    chan=(); [[ $scheduled -eq 1 ]] && chan=(--channel stable)
    rc=0; "$PY" "$APP/updater.py" check --force ${chan[@]+"${chan[@]}"} || rc=$?
    [[ $check -eq 1 ]] && exit 0
    if [[ $rc -ne 10 ]]; then echo "==> nothing to update"; exit 0; fi
    l9s_up="$("$PY" -c 'import json,sys; d=json.load(open(sys.argv[1])); print(int(bool((d.get("l9s") or {}).get("update"))), int(bool((d.get("server") or {}).get("update") and (d.get("server") or {}).get("auto"))))' "$UPCACHE")"
    read -r want_l9s want_srv <<< "$l9s_up"
    if [[ $want_l9s -eq 0 && $want_srv -eq 0 ]]; then
      echo "==> nothing l9s installs automatically (see the vLLM note above)"; exit 0
    fi
    if [[ $yes -eq 0 ]]; then
      [[ -r /dev/tty ]] || die "no terminal to confirm on; re-run with -y"
      read -r -p "Update now? [y/N] " ans < /dev/tty
      [[ "$ans" == [yY]* ]] || { echo "cancelled"; exit 1; }
    fi
    mlx_before=""; [[ "$BACKEND" == "mlx" ]] && mlx_before="$("$PY" -c 'from importlib.metadata import version; print(version("mlx-lm"))' 2>/dev/null || true)"
    "$PY" "$APP/backup.py" now "update from $(cat "$APP/VERSION")" >/dev/null 2>&1 || true
    echo "==> updating l9s"
    ref="$("$PY" -c 'import json,sys; print((json.load(open(sys.argv[1])).get("l9s") or {}).get("ref") or "")' "$UPCACHE" 2>/dev/null || true)"
    curl -fsSL "https://raw.githubusercontent.com/JongoDB/l9s/main/get.sh" | bash -s -- --update ${ref:+--ref "$ref"} || die "update failed (your install is unchanged where the step failed; see above)"
    if [[ "$BACKEND" == "mlx" ]]; then
      mlx_after="$("$PY" -c 'from importlib.metadata import version; print(version("mlx-lm"))' 2>/dev/null || true)"
      if [[ -n "$mlx_before" && "$mlx_before" != "$mlx_after" ]] && mlx_running; then
        if [[ $scheduled -eq 1 ]]; then
          mkdir -p "$L9S_HOME/cache"; echo "mlx-lm $mlx_before -> $mlx_after" > "$L9S_HOME/cache/restart-pending"
          echo "==> mlx-lm updated ($mlx_before -> $mlx_after); restart the server to use it (l9s restart)"
        else
          echo "==> mlx-lm updated ($mlx_before -> $mlx_after): restarting the model server"
          "$L9S_HOME/bin/l9s" restart
        fi
      fi
    fi
    "$PY" "$APP/updater.py" check --force --quiet || true
    echo "==> l9s is now $(cat "$APP/VERSION")" ;;
  uninstall)
    yes=0 keep=1 rmmodels=0 rmimage=0
    while [[ $# -gt 0 ]]; do
      case "$1" in
        -y|--yes) yes=1 ;; --keep-config) keep=1 ;; --purge) keep=0 ;;
        --remove-models) rmmodels=1 ;; --remove-image) rmimage=1 ;;
        *) die "usage: l9s uninstall [-y] [--purge] [--remove-models] [--remove-image]" ;;
      esac; shift
    done
    repos=()
    for f in "$PROFILES"/*; do [[ -f "$f" ]] && repos+=("$(head -1 "$f")"); done
    echo "This removes l9s from this machine:"
    echo "  - the model server ($([[ "$BACKEND" == "mlx" ]] && echo "launchd agent $LABEL" || echo "container $CONTAINER"))"
    echo "  - the request proxy service, the l9s command"
    [[ $keep -eq 1 ]] && echo "  - the program files in $L9S_HOME (your settings, keys, linked servers, profiles and history stay: a reinstall picks them up; --purge removes them too)" \
                      || echo "  - $L9S_HOME and its backups (settings, API key, keys, linked servers, profiles, history)"
    [[ $rmmodels -eq 1 && ${#repos[@]} -gt 0 ]] && echo "  - downloaded models used by your profiles: ${repos[*]}"
    [[ $rmimage -eq 1 && "$BACKEND" == "vllm" ]] && echo "  - the Docker image $IMAGE"
    [[ $rmmodels -eq 0 ]] && echo "Downloaded models stay in $HF_CACHE (add --remove-models to delete the ones your profiles use)."
    if [[ $yes -eq 0 ]]; then
      [[ -r /dev/tty ]] || die "no terminal to confirm on; re-run with -y"
      read -r -p "Continue? [y/N] " ans < /dev/tty
      [[ "$ans" == [yY]* ]] || { echo "cancelled"; exit 1; }
    fi
    [[ -x "$PY" ]] && "$PY" "$APP/backup.py" now uninstall >/dev/null 2>&1 || true
    # whatever `l9s expose` set up (tunnel service, Tailscale Funnel / Serve, the Caddy site): undone first
    if [[ -x "$PY" && -n "${EXPOSE:-}${PUBLIC_URL:-}" ]]; then
      "$PY" -c "import sys; sys.path.insert(0, '$APP'); import expose; expose.stop_front_end()" 2>/dev/null || true
      echo "==> front end removed (${EXPOSE:-your own})"
    fi
    if [[ "$OS" == "Darwin" ]]; then  # (client mode may still have the agent from an earlier personal / shared mode)
      launchctl bootout "gui/$UID/$LABEL" 2>/dev/null || true
      rm -f "$(plist_path $LABEL)"
    elif command -v docker >/dev/null 2>&1; then
      docker rm -f "$CONTAINER" >/dev/null 2>&1 || true
      [[ $rmimage -eq 1 ]] && docker rmi "$IMAGE" >/dev/null 2>&1 || true
    fi
    echo "==> model server removed"
    if [[ "$OS" == "Darwin" ]]; then
      for l in "$PROXY_LABEL" dev.l9s.update dev.l9s.tunnel; do
        launchctl bootout "gui/$UID/$l" 2>/dev/null || true
        rm -f "$(plist_path "$l")"
      done
    else
      sudo systemctl disable --now l9s-proxy l9s-update.timer l9s-update l9s-tunnel >/dev/null 2>&1 || true
      sudo rm -f /etc/systemd/system/l9s-{proxy,update,tunnel}.service /etc/systemd/system/l9s-update.timer
      sudo systemctl daemon-reload
    fi
    echo "==> services removed (request proxy, daily update check, tunnel)"
    if [[ $rmmodels -eq 1 && ${#repos[@]} -gt 0 && -x "$PY" ]]; then
      "$PY" - "${repos[@]}" <<'PYEOF2'
import sys
from huggingface_hub import scan_cache_dir
info = scan_cache_dir()
hashes = [rev.commit_hash for r in info.repos if r.repo_id in sys.argv[1:] for rev in r.revisions]
if hashes:
    strategy = info.delete_revisions(*hashes)
    print(f"==> deleted models, freed {strategy.expected_freed_size / 1e9:.1f} GB")
    strategy.execute()
PYEOF2
    fi
    for link in /usr/local/bin/l9s /usr/local/bin/llm "$HOME/.local/bin/l9s"; do
      if [[ -L "$link" && "$(readlink "$link")" == "$L9S_HOME/bin/l9s" ]]; then
        if [[ -w "$(dirname "$link")" ]]; then rm -f "$link"; else sudo rm -f "$link"; fi
      fi
    done
    if [[ $keep -eq 1 ]]; then
      rm -rf "$L9S_HOME/app" "$L9S_HOME/bin" "$L9S_HOME/src" "$L9S_HOME/logs" "$L9S_HOME/downloads"
      find "$L9S_HOME/cache" -mindepth 1 ! -name usage.json -delete 2>/dev/null || true  # (per-key usage stays)
    else
      rm -rf "$L9S_HOME" "${L9S_HOME}-backups"
    fi
    left="uv and the hf CLI (~/.local/bin)"
    [[ $rmmodels -eq 0 ]] && left+=", downloaded models ($HF_CACHE)"
    [[ $rmimage -eq 0 && "$BACKEND" == "vllm" ]] && left+=", the vLLM Docker image"
    [[ $keep -eq 1 ]] && left+=", your setup in $L9S_HOME and backups in ${L9S_HOME}-backups (reinstalling picks it up)"
    echo "==> l9s uninstalled. Left in place: $left."
    exit 0 ;;
  help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
