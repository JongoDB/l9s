[Unit]
Description=vllm-tui-proxy: request-tracking proxy in front of the model server
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=@USER@
Environment=VLLM_TUI_HOME=@VLLM_TUI_HOME@
ExecStart=@VLLM_TUI_HOME@/app/.venv/bin/python @VLLM_TUI_HOME@/app/proxy.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
